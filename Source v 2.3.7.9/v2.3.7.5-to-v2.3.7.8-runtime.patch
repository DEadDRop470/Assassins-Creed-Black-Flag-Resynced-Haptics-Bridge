+static void* acquire_gameinput_reading(GameInputGetCurrentReadingFn getReading,
+                                      GameInputGamepadStateV0& source,
+                                      void** feedbackDevice) {
+    static constexpr u32 kinds[2] = {0x00040004u, 0x00040000u};
+    *feedbackDevice = nullptr;
+    for (u32 attempt = 0; attempt < 2; ++attempt) {
+        void* reading = nullptr;
