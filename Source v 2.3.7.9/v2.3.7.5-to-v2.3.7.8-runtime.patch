+static bool compat_address_range(const void* address, u64 length, bool executable) {
+    u64 at = (u64)address;
+    if (!at || !length || length > ~0ull - at || !g_api.VirtualQuery) return false;
+    u64 end = at + length;
+    while (at < end) {
+        CompatMemoryInfo m{};
+        if (g_api.VirtualQuery((void*)at, &m, sizeof(m)) != sizeof(m) ||
+            !compat_region_allowed(m, executable)) return false;
+        u64 next = (u64)m.BaseAddress + m.RegionSize;
+        if ((u64)m.BaseAddress > at || next <= at) return false;
+        at = next < end ? next : end;
+    }
+    return true;
+}
+static volatile u32 g_pointerProtectionFailures{};
+// Pointer hooks publish originals first, then atomically exchange aligned slots.
+// Preserve execution permission if the slot happens to share an executable page.
+static bool compat_swap_pointer(u64* slot, u64 expected, u64 replacement) {
+    if (!slot || ((u64)slot & 7ull) || !g_api.VirtualProtect ||
+        !compat_address_range(slot, sizeof(u64), false)) return false;
+    CompatMemoryInfo m{};
+    if (g_api.VirtualQuery(slot, &m, sizeof(m)) != sizeof(m)) return false;
+    DWORD writable = compat_region_allowed(m, true) ?
+                     PAGE_EXECUTE_READWRITE : PAGE_READWRITE;
+    DWORD oldProtect = 0;
+    if (!g_api.VirtualProtect(slot, sizeof(u64), writable, &oldProtect)) return false;
+    bool changed = atomic_cas_u64(slot, expected, replacement);
+    DWORD ignored = 0;
+    if (!g_api.VirtualProtect(slot, sizeof(u64), oldProtect, &ignored)) {
+        atomic_fetch_add_u32(&g_pointerProtectionFailures, 1);
+        // Retain saved originals even after rollback: another thread may have
+        // entered the briefly published hook before this exchange.
+        if (changed) atomic_cas_u64(slot, replacement, expected);
+        if (!g_api.VirtualProtect(slot, sizeof(u64), oldProtect, &ignored))
+            atomic_fetch_add_u32(&g_pointerProtectionFailures, 1);
+        return false;
+    }
+    return changed;
+}
